{
  "name": "pulse-terminal",
  "version": "1.0.0",
  "description": "A fast, multi-tab, themeable terminal for Windows and Linux",
  "homepage": "https://github.com/code-dev-env/pulse-terminal",
  "repository": {
    "type": "git",
    "url": "https://github.com/code-dev-env/pulse-terminal.git"
  },
  "main": "src/main.js",
  "desktopName": "pulse-terminal.desktop",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux --config.npmRebuild=true",
    "dist:appimage": "electron-builder --linux AppImage --config.npmRebuild=true",
    "dist:deb": "electron-builder --linux deb --config.npmRebuild=true"
  },
  "keywords": [],
  "author": "code.dev.ai",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "koffi": "^3.3.3",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.codedevai.pulseterminal",
    "productName": "Pulse Terminal",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Pulse Terminal Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Pulse Terminal Setup.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "System;TerminalEmulator",
      "maintainer": "code.dev.ai <code.dev.ai@outlook.com>",
      "synopsis": "A fast, multi-tab, themeable terminal",
      "description": "Pulse Terminal is a fast, multi-tab, fully customizable terminal with themes, a powerline prompt and a system-info startup banner.",
      "executableName": "pulse-terminal",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Pulse-Terminal-${version}-${arch}.AppImage"
    }
  }
}
